# ---- Required ----
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/civicslot?appName=CivicSlot
# Use a long random value (64+ hex chars). Rotating it signs everyone out.
JWT_SECRET=change_this_to_a_long_random_secret

# ---- Sessions ----
# Mobile app + citizens
JWT_EXPIRES_IN=7d
# Web administration portal sessions (POST /api/auth/admin-login)
JWT_ADMIN_EXPIRES_IN=8h

# ---- Web portal / CORS ----
# Comma-separated list of browser origins allowed to call the API, e.g. the
# Vercel URL of the administration portal. The mobile app does not send an
# Origin header and is unaffected. In production an empty list blocks all
# browser origins.
CORS_ORIGINS=https://your-portal.vercel.app,http://localhost:5173

# ---- Platform behaviour ----
NODE_ENV=production
# IANA timezone used for "is this time slot already in the past?" checks
APP_TIMEZONE=Africa/Douala
# Number of reverse-proxy hops in front of the app (Render = 1)
TRUST_PROXY=1

# ---- Abuse protection (optional overrides) ----
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_GLOBAL_MAX=1500
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Seed script only (npm run seed) ----
# SEED_SUPERADMIN_PASSWORD=
# SEED_REGIONAL_ADMIN_PASSWORD=
